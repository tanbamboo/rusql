{
  "suites": [
    {
      "name": "basic_dml",
      "steps": [
        {
          "sql": "CREATE TABLE users (id INT, name VARCHAR(32))",
          "expect": { "type": "ok" }
        },
        {
          "sql": "INSERT INTO users VALUES (1, 'alice')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "INSERT INTO users VALUES (2, 'bob')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "SELECT * FROM users",
          "expect": {
            "type": "rows",
            "columns": ["id", "name"],
            "rows": [["1", "alice"], ["2", "bob"]]
          }
        },
        {
          "sql": "SELECT name FROM users",
          "expect": {
            "type": "rows",
            "columns": ["name"],
            "rows": [["alice"], ["bob"]]
          }
        },
        {
          "sql": "SELECT id FROM users WHERE id = 2",
          "expect": {
            "type": "rows",
            "columns": ["id"],
            "rows": [["2"]]
          }
        },
        {
          "sql": "SELECT * FROM users LIMIT 1",
          "expect": {
            "type": "rows",
            "columns": ["id", "name"],
            "rows": [["1", "alice"]]
          }
        },
        {
          "sql": "SELECT * FROM users ORDER BY id",
          "expect": {
            "type": "rows",
            "columns": ["id", "name"],
            "rows": [["1", "alice"], ["2", "bob"]]
          }
        },
        {
          "sql": "SELECT name FROM users ORDER BY name DESC",
          "expect": {
            "type": "rows",
            "columns": ["name"],
            "rows": [["bob"], ["alice"]]
          }
        },
        {
          "sql": "SELECT id AS user_id FROM users",
          "expect": {
            "type": "rows",
            "columns": ["user_id"],
            "rows": [["1"], ["2"]]
          }
        },
        {
          "sql": "SELECT * FROM users ORDER BY id LIMIT 1 OFFSET 1",
          "expect": {
            "type": "rows",
            "columns": ["id", "name"],
            "rows": [["2", "bob"]]
          }
        }
      ]
    },
    {
      "name": "index_where",
      "steps": [
        {
          "sql": "CREATE TABLE items (id INT, label VARCHAR(16))",
          "expect": { "type": "ok" }
        },
        {
          "sql": "INSERT INTO items VALUES (10, 'x')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "INSERT INTO items VALUES (20, 'y')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "CREATE INDEX idx_items_id ON items (id)",
          "expect": { "type": "ok" }
        },
        {
          "sql": "SELECT * FROM items WHERE id = 20",
          "expect": {
            "type": "rows",
            "columns": ["id", "label"],
            "rows": [["20", "y"]]
          }
        }
      ]
    },
    {
      "name": "select_literal",
      "steps": [
        {
          "sql": "SELECT 1",
          "expect": {
            "type": "rows",
            "columns": ["1"],
            "rows": [["1"]]
          }
        }
      ]
    },
    {
      "name": "transactions",
      "steps": [
        {
          "sql": "CREATE TABLE ledgers (id INT)",
          "expect": { "type": "ok" }
        },
        {
          "sql": "BEGIN",
          "expect": { "type": "ok" }
        },
        {
          "sql": "INSERT INTO ledgers VALUES (1)",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "SELECT * FROM ledgers",
          "expect": {
            "type": "rows",
            "columns": ["id"],
            "rows": [["1"]]
          }
        },
        {
          "sql": "COMMIT",
          "expect": { "type": "ok" }
        },
        {
          "sql": "SELECT * FROM ledgers",
          "expect": {
            "type": "rows",
            "columns": ["id"],
            "rows": [["1"]]
          }
        }
      ]
    },
    {
      "name": "show_tables",
      "steps": [
        {
          "sql": "CREATE TABLE meta_t (id INT)",
          "expect": { "type": "ok" }
        },
        {
          "sql": "SHOW TABLES",
          "expect": {
            "type": "rows",
            "columns": ["Tables_in_rusql"],
            "rows": [["meta_t"]]
          }
        },
        {
          "sql": "SHOW DATABASES",
          "expect": {
            "type": "rows",
            "columns": ["Database"],
            "rows": [["rusql"]]
          }
        },
        {
          "sql": "USE rusql",
          "expect": { "type": "ok" }
        }
      ]
    },
    {
      "name": "describe_info_schema",
      "steps": [
        {
          "sql": "CREATE TABLE desc_t (id INT, label VARCHAR(16))",
          "expect": { "type": "ok" }
        },
        {
          "sql": "DESCRIBE desc_t",
          "expect": {
            "type": "rows",
            "columns": ["Field", "Type", "Null", "Key", "Default", "Extra"],
            "rows": [
              ["id", "int", "YES", "", "NULL", ""],
              ["label", "varchar(16)", "YES", "", "NULL", ""]
            ]
          }
        },
        {
          "sql": "SHOW COLUMNS FROM desc_t",
          "expect": {
            "type": "rows",
            "columns": ["Field", "Type", "Null", "Key", "Default", "Extra"],
            "rows": [
              ["id", "int", "YES", "", "NULL", ""],
              ["label", "varchar(16)", "YES", "", "NULL", ""]
            ]
          }
        },
        {
          "sql": "SELECT * FROM information_schema.tables",
          "expect": {
            "type": "rows",
            "columns": ["TABLE_SCHEMA", "TABLE_NAME", "TABLE_TYPE"],
            "rows": [["rusql", "desc_t", "BASE TABLE"]]
          }
        },
        {
          "sql": "SELECT * FROM information_schema.columns WHERE table_name = 'desc_t'",
          "expect": {
            "type": "rows",
            "columns": [
              "TABLE_SCHEMA",
              "TABLE_NAME",
              "COLUMN_NAME",
              "ORDINAL_POSITION",
              "COLUMN_TYPE",
              "IS_NULLABLE",
              "COLUMN_COLLATION"
            ],
            "rows": [
              ["rusql", "desc_t", "id", "1", "int", "YES", "utf8mb4_unicode_ci"],
              ["rusql", "desc_t", "label", "2", "varchar(16)", "YES", "utf8mb4_unicode_ci"]
            ]
          }
        },
        {
          "sql": "SHOW CREATE TABLE desc_t",
          "expect": {
            "type": "rows",
            "columns": ["Table", "Create Table"],
            "rows": [
              [
                "desc_t",
                "CREATE TABLE `desc_t` (`id` INT, `label` VARCHAR(16))"
              ]
            ]
          }
        }
      ]
    },
    {
      "name": "drop_and_delete",
      "steps": [
        {
          "sql": "CREATE TABLE tmp (id INT)",
          "expect": { "type": "ok" }
        },
        {
          "sql": "INSERT INTO tmp VALUES (1)",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "INSERT INTO tmp VALUES (2)",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "DELETE FROM tmp WHERE id = 1",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "UPDATE tmp SET id = 3 WHERE id = 2",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "SELECT * FROM tmp",
          "expect": {
            "type": "rows",
            "columns": ["id"],
            "rows": [["3"]]
          }
        },
        {
          "sql": "DROP TABLE tmp",
          "expect": { "type": "ok" }
        }
      ]
    },
    {
      "name": "where_comparisons",
      "steps": [
        {
          "sql": "CREATE TABLE scores (id INT, name VARCHAR(16))",
          "expect": { "type": "ok" }
        },
        {
          "sql": "INSERT INTO scores VALUES (1, 'alice')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "INSERT INTO scores VALUES (2, 'bob')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "INSERT INTO scores VALUES (3, 'carol')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "SELECT * FROM scores WHERE id > 1",
          "expect": {
            "type": "rows",
            "columns": ["id", "name"],
            "rows": [["2", "bob"], ["3", "carol"]]
          }
        },
        {
          "sql": "SELECT name FROM scores WHERE id = 2 AND name = 'bob'",
          "expect": {
            "type": "rows",
            "columns": ["name"],
            "rows": [["bob"]]
          }
        },
        {
          "sql": "SELECT id FROM scores WHERE id <> 2",
          "expect": {
            "type": "rows",
            "columns": ["id"],
            "rows": [["1"], ["3"]]
          }
        }
      ]
    },
    {
      "name": "where_is_null",
      "steps": [
        {
          "sql": "CREATE TABLE nullable_t (id INT, note VARCHAR(16))",
          "expect": { "type": "ok" }
        },
        {
          "sql": "INSERT INTO nullable_t VALUES (1, NULL)",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "INSERT INTO nullable_t VALUES (2, 'ok')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "SELECT id FROM nullable_t WHERE note IS NULL",
          "expect": {
            "type": "rows",
            "columns": ["id"],
            "rows": [["1"]]
          }
        },
        {
          "sql": "SELECT id FROM nullable_t WHERE note IS NOT NULL",
          "expect": {
            "type": "rows",
            "columns": ["id"],
            "rows": [["2"]]
          }
        }
      ]
    },
    {
      "name": "inner_join",
      "steps": [
        {
          "sql": "CREATE TABLE orders (id INT, customer VARCHAR(16))",
          "expect": { "type": "ok" }
        },
        {
          "sql": "CREATE TABLE order_items (order_id INT, sku VARCHAR(16))",
          "expect": { "type": "ok" }
        },
        {
          "sql": "INSERT INTO orders VALUES (1, 'alice')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "INSERT INTO orders VALUES (2, 'bob')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "INSERT INTO order_items VALUES (1, 'widget')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "INSERT INTO order_items VALUES (1, 'gadget')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "INSERT INTO order_items VALUES (2, 'widget')",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "SELECT orders.id, order_items.sku FROM orders INNER JOIN order_items ON orders.id = order_items.order_id WHERE orders.id = 1",
          "expect": {
            "type": "rows",
            "columns": ["id", "sku"],
            "rows": [["1", "widget"], ["1", "gadget"]]
          }
        }
      ]
    },
    {
      "name": "primary_key_metadata",
      "steps": [
        {
          "sql": "CREATE TABLE pk_t (id INT PRIMARY KEY, label VARCHAR(16) NOT NULL)",
          "expect": { "type": "ok" }
        },
        {
          "sql": "DESCRIBE pk_t",
          "expect": {
            "type": "rows",
            "columns": ["Field", "Type", "Null", "Key", "Default", "Extra"],
            "rows": [
              ["id", "int", "NO", "PRI", "NULL", ""],
              ["label", "varchar(16)", "NO", "", "NULL", ""]
            ]
          }
        },
        {
          "sql": "SHOW CREATE TABLE pk_t",
          "expect": {
            "type": "rows",
            "columns": ["Table", "Create Table"],
            "rows": [
              [
                "pk_t",
                "CREATE TABLE `pk_t` (`id` INT NOT NULL PRIMARY KEY, `label` VARCHAR(16) NOT NULL)"
              ]
            ]
          }
        }
      ]
    },
    {
      "name": "alter_add_column",
      "steps": [
        {
          "sql": "CREATE TABLE alter_compat (id INT)",
          "expect": { "type": "ok" }
        },
        {
          "sql": "INSERT INTO alter_compat VALUES (1)",
          "expect": { "type": "ok", "affected_rows": 1 }
        },
        {
          "sql": "ALTER TABLE alter_compat ADD COLUMN label VARCHAR(16)",
          "expect": { "type": "ok" }
        },
        {
          "sql": "SELECT id, label FROM alter_compat",
          "expect": {
            "type": "rows",
            "columns": ["id", "label"],
            "rows": [["1", ""]]
          }
        },
        {
          "sql": "DESCRIBE alter_compat",
          "expect": {
            "type": "rows",
            "columns": ["Field", "Type", "Null", "Key", "Default", "Extra"],
            "rows": [
              ["id", "int", "YES", "", "NULL", ""],
              ["label", "varchar(16)", "YES", "", "NULL", ""]
            ]
          }
        }
      ]
    },
    {
      "name": "information_schema_schemata_statistics",
      "steps": [
        {
          "sql": "CREATE TABLE stat_t (id INT PRIMARY KEY, name VARCHAR(16))",
          "expect": { "type": "ok" }
        },
        {
          "sql": "CREATE INDEX idx_stat_name ON stat_t (name)",
          "expect": { "type": "ok" }
        },
        {
          "sql": "SELECT * FROM information_schema.SCHEMATA",
          "expect": {
            "type": "rows",
            "columns": ["SCHEMA_NAME", "DEFAULT_CHARACTER_SET_NAME", "DEFAULT_COLLATION_NAME"],
            "rows": [["rusql", "utf8mb4", "utf8mb4_unicode_ci"]]
          }
        },
        {
          "sql": "SELECT * FROM information_schema.STATISTICS WHERE TABLE_NAME = 'stat_t' ORDER BY INDEX_NAME, COLUMN_NAME",
          "expect": {
            "type": "rows",
            "columns": ["TABLE_SCHEMA", "TABLE_NAME", "INDEX_NAME", "SEQ_IN_INDEX", "COLUMN_NAME", "NON_UNIQUE", "INDEX_TYPE"],
            "rows": [
              ["rusql", "stat_t", "PRIMARY", "1", "id", "0", "BTREE"],
              ["rusql", "stat_t", "idx_stat_name", "1", "name", "1", "BTREE"]
            ]
          }
        }
      ]
    },
    {
      "name": "show_index",
      "steps": [
        {
          "sql": "CREATE TABLE show_idx_t (id INT PRIMARY KEY, name VARCHAR(16))",
          "expect": { "type": "ok" }
        },
        {
          "sql": "CREATE INDEX idx_show_name ON show_idx_t (name)",
          "expect": { "type": "ok" }
        },
        {
          "sql": "SHOW INDEX FROM show_idx_t",
          "expect": {
            "type": "rows",
            "columns": ["Table", "Non_unique", "Key_name", "Seq_in_index", "Column_name", "Index_type"],
            "rows": [
              ["show_idx_t", "0", "PRIMARY", "1", "id", "BTREE"],
              ["show_idx_t", "1", "idx_show_name", "1", "name", "BTREE"]
            ]
          }
        },
        {
          "sql": "SHOW INDEXES FROM show_idx_t",
          "expect": {
            "type": "rows",
            "columns": ["Table", "Non_unique", "Key_name", "Seq_in_index", "Column_name", "Index_type"],
            "rows": [
              ["show_idx_t", "0", "PRIMARY", "1", "id", "BTREE"],
              ["show_idx_t", "1", "idx_show_name", "1", "name", "BTREE"]
            ]
          }
        }
      ]
    }
  ]
}

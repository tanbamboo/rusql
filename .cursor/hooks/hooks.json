{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start.ps1"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/before-shell-guard.ps1",
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/after-file-edit.ps1",
        "matcher": "Write|TabWrite"
      }
    ]
  }
}
